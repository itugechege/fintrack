# =======================================
# SCALARS
# =======================================
scalar JSON
scalar DateTime

# =======================================
# ENUMS
# =======================================
enum AccountType {
    CASH
    BANK
    CREDIT
    INVESTMENT
}

enum TransactionType {
    INCOME
    EXPENSE
    TRANSFER
}

enum BudgetPeriod {
    DAILY
    WEEKLY
    MONTHLY
    YEARLY
}

enum AssetType {
    STOCK
    CRYPTO
    FOREX
}

enum ReportType {
    EXPENSE_SUMMARY
    INCOME_SUMMARY
    BUDGET_PROGRESS
    GOAL_PROGRESS
    INVESTMENT_PORTFOLIO
    MARKET_TRACKING
}

# =======================================
# TYPES
# =======================================
type User {
    id: ID!
    username: String!
    email: String!
    emailVerified: Boolean
    phoneNumber: String
    phoneVerified: Boolean
    firstName: String!
    lastName: String!
    sirName: String
    dateOfBirth: DateTime
    gender: String
    country: String
    city: String
    occupation: String
    incomeBracket: String
    preferredCurrency: String
    createdAt: DateTime
    updatedAt: DateTime

    sessions: [Session!]
    accounts: [Account!]
    goals: [Goal!]
    budgets: [Budget!]
    reports: [Report!]
    portfolio: [UserPortfolio!]
    sessionEvents: [SessionEvent!]
    sessionFactors: [SessionFactor!]
}

type Session {
    id: ID!
    user: User!
    sessionStart: DateTime
    sessionEnd: DateTime
    isActive: Boolean
    deviceType: String
    deviceModel: String
    osVersion: String
    appVersion: String
    ipAddress: String
    networkType: String
    location: String
    actionsCount: Int
    transactionsCount: Int
    avgScreenTime: Float
    crashReports: JSON

    events: [SessionEvent!]
    factors: [SessionFactor!]
}

type SessionEvent {
    id: ID!
    session: Session!
    user: User!
    eventType: String!
    eventData: JSON
    eventTime: DateTime
}

type SessionFactor {
    id: ID!
    session: Session
    user: User!
    factorType: String!
    factorValue: String
    factorScore: Float
    recordedAt: DateTime
}

type Account {
    id: ID!
    user: User!
    name: String!
    type: AccountType!
    currency: String!
    provider: String
    balance: Float
    availableBalance: Float
    totalInflow: Float
    totalOutflow: Float
    numTransactions: Int
    accountCreatedAt: DateTime
    accountUpdatedAt: DateTime
    closedAt: DateTime
    lastSynced: DateTime

    transactions: [Transaction!]
}

type Transaction {
    id: ID!
    account: Account!
    type: TransactionType!
    category: String
    amount: Float!
    location: String
    merchant: String
    description: String
    paymentMethod: String
    recurring: Boolean
    tag: String
    transactionDate: DateTime
}

type Category {
    id: ID!
    name: String!
    type: TransactionType!
    totalTransactions: Int
    totalAmount: Float
}

type Budget {
    id: ID!
    user: User!
    name: String!
    amount: Float!
    period: BudgetPeriod
    category: String
    startDate: DateTime
    endDate: DateTime
    spendAmount: Float
    remainingBalance: Float
    budgetStatus: Boolean
}

type Goal {
    id: ID!
    user: User!
    name: String!
    targetAmount: Float!
    currentAmount: Float
    progressPercentage: Float
    numContributions: Int
    createdAt: DateTime
    dueDate: DateTime
}

type MarketAsset {
    id: ID!
    symbol: String!
    name: String!
    type: AssetType!
    currency: String!
    portfolio: [UserPortfolio!]
    prices: [MarketPrice!]
}

type UserPortfolio {
    id: ID!
    user: User!
    asset: MarketAsset!
    quantity: Float
    avgPrice: Float
    currentPrice: Float
    lastUpdated: DateTime
}

type MarketPrice {
    id: ID!
    asset: MarketAsset!
    price: Float!
    recordedAt: DateTime
}

type Report {
    id: ID!
    user: User!
    type: ReportType!
    dataJson: JSON!
    generatedAt: DateTime
}

# =======================================
# QUERIES
# =======================================
type Query {
    # Users
    users: [User!]
    user(id: ID!): User
    userByEmail(email: String!): User

    # Sessions
    sessions: [Session!]
    session(id: ID!): Session
    sessionsByUser(userId: ID!): [Session!]

    # Accounts
    accounts: [Account!]
    account(id: ID!): Account
    accountsByUser(userId: ID!): [Account!]

    # Transactions
    transactions: [Transaction!]
    transaction(id: ID!): Transaction
    transactionsByAccount(accountId: ID!): [Transaction!]
    transactionsByUser(userId: ID!): [Transaction!]

    # Categories
    categories: [Category!]
    category(id: ID!): Category

    # Budgets
    budgets: [Budget!]
    budget(id: ID!): Budget
    budgetsByUser(userId: ID!): [Budget!]

    # Goals
    goals: [Goal!]
    goal(id: ID!): Goal
    goalsByUser(userId: ID!): [Goal!]

    # Market Assets
    marketAssets: [MarketAsset!]
    marketAsset(id: ID!): MarketAsset

    # User Portfolio
    userPortfolio(userId: ID!): [UserPortfolio!]

    # Market Prices
    marketPrices(assetId: ID!): [MarketPrice!]

    # Reports
    reports: [Report!]
    report(id: ID!): Report
    reportsByUser(userId: ID!): [Report!]
}

# =======================================
# MUTATIONS
# =======================================
type Mutation {
    # Users
    createUser(
        username: String!
        email: String!
        password: String!
        firstName: String!
        lastName: String!
    ): User!
    updateUser(
        id: ID!
        email: String
        phoneNumber: String
        preferredCurrency: String
    ): User!
    deleteUser(id: ID!): Boolean

    # Accounts
    createAccount(
        userId: ID!
        name: String!
        type: AccountType!
        currency: String!
        provider: String
    ): Account!
    updateAccount(
        id: ID!
        name: String
        type: AccountType
        currency: String
        provider: String
        balance: Float
        availableBalance: Float
    ): Account!
    deleteAccount(id: ID!): Boolean

    # Transactions
    createTransaction(
        accountId: ID!
        type: TransactionType!
        amount: Float!
        category: String
        location: String
        merchant: String
        description: String
        paymentMethod: String
        recurring: Boolean
        tag: String
        transactionDate: DateTime
    ): Transaction!
    updateTransaction(
        id: ID!
        type: TransactionType
        amount: Float
        category: String
        location: String
        merchant: String
        description: String
    ): Transaction!
    deleteTransaction(id: ID!): Boolean

    # Budgets
    createBudget(
        userId: ID!
        name: String!
        amount: Float!
        period: BudgetPeriod
        category: String
    ): Budget!
    updateBudget(
        id: ID!
        name: String
        amount: Float
        period: BudgetPeriod
        category: String
    ): Budget!
    deleteBudget(id: ID!): Boolean

    # Goals
    createGoal(
        userId: ID!
        name: String!
        targetAmount: Float!
        dueDate: DateTime
    ): Goal!
    updateGoal(
        id: ID!
        name: String
        targetAmount: Float
        currentAmount: Float
        progressPercentage: Float
    ): Goal!
    deleteGoal(id: ID!): Boolean

    # Reports
    createReport(
        userId: ID!
        type: ReportType!
        dataJson: JSON!
    ): Report!
    deleteReport(id: ID!): Boolean
}
