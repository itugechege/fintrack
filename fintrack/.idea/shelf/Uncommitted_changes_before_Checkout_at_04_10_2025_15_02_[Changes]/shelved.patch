+package com.example.fintrack.util
+
+import java.io.OutputStream
+
+suspend fun exportBudgetToCsv(budgetWithItems: BudgetWithItems, outputStream: OutputStream) {
+    val writer = outputStream.bufferedWriter()
+    writer.appendLine("category,allocated,spent,note")
+    budgetWithItems.items.forEach { item ->
+        writer.appendLine("${escapeCsv(item.category)},${item.allocated},${item.spent},${escapeCsv(item.note)}")
+    }
+    writer.flush()
+}
+
+private fun escapeCsv(s: String?) = s?.replace("\"", "\"\"")?.let { "\"$it\"" } ?: ""
